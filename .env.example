# Free AI providers (pick ONE — no credit card required; app runs deterministic fallback if all are unset)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults: whisper-large-v3-turbo, openai/gpt-oss-20b, gemini-2.5-flash, gpt-4o-mini)
GROQ_WHISPER_MODEL=
GROQ_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=

# Optional persistent Vercel storage (1-click free tier via `vercel integration add upstash`)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional real Twilio Voice phone webhook security & recording download
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional runtime overrides
BETHANY_DB_PATH=
CORS_ORIGIN=
