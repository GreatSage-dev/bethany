{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo zero-runtime-dependencies",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/pastor-sunday-recap.wav"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=$1"
    },
    {
      "source": "/phone",
      "destination": "/phone.html"
    },
    {
      "source": "/judge",
      "destination": "/phone.html"
    }
  ]
}
